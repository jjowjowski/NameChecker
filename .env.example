# Copy to .env for local runs (python main.py reads the real environment; use
# `set -a; source .env; set +a` or your IDE to load it). On Railway, set these as
# service Variables instead.

# Google Alerts feed URL (Alerts > "Deliver to: RSS feed" > copy the RSS link)
GOOGLE_ALERTS_RSS_URL=https://www.google.com/alerts/feeds/00000000000000000000/0000000000000000000

# Anthropic API key, used for the web search source and the row descriptions
ANTHROPIC_API_KEY=sk-ant-...

# Google service account key: paste the WHOLE JSON key file on one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"mentions-tracker@your-project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789

# Telegram bot token from @BotFather, and your chat ID
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExample
TELEGRAM_CHAT_ID=123456789

# Optional: extra name variants, separated by semicolons
# EXTRA_NAME_VARIANTS=Jett R. Groshinski;Groshinski J
